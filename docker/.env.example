# Copy to .env and fill in before running `docker compose up`.

# Shared secret between the signaling server and coturn. Generate with:
#   openssl rand -hex 32
TURN_SHARED_SECRET=

# Public hostname/IP of this server, used as the coturn realm and in the
# TURN URL handed out to clients (e.g. relay.example.com).
PUBLIC_HOST=

# Public IP address coturn advertises in relay candidates (must be the real
# internet-facing IP, not a private/LAN address).
PUBLIC_IP=

# Hostname Caddy will route to the signaling service, e.g. visuara.example.com
SIGNALING_HOSTNAME=

# There is no separate admin password anymore: the first account ever
# registered through the web UI automatically becomes the admin account,
# and registration closes to the public immediately afterward. If you're
# upgrading an existing deployment with accounts already in it (from before
# this became per-account), see the "Upgrading" note in the root README for
# how to bootstrap an admin manually.
